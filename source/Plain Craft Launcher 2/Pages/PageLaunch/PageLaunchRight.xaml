<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,0,0,15" Title="整合包修订" x:Name="PanPackUpdate" Visibility="Collapsed">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock x:Name="LabPackUpdate" Text="" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ColorBrush1}" />
                    <Border x:Name="PanPackProgress" Margin="0,12,0,0" Padding="10,8,10,10" CornerRadius="4"
                            Background="{DynamicResource ColorBrush8}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="LabPackProgress" Text="" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ColorBrush1}" />
                            <ProgressBar x:Name="BarPackProgress" Height="6" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0"
                                         BorderThickness="0" Background="{DynamicResource ColorBrush7}" Foreground="{DynamicResource ColorBrush3}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="{TemplateBinding Foreground}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnPackUpdate" Height="34" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Padding="24,0" BorderThickness="0" Cursor="Hand" Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource ColorBrush2}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorBrush3}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorBrush1}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="立即更新" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                    </Button>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="方块次元 · NJIT Minecraft Club" x:Name="PanClub">
                <Grid Margin="21,40,21,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True" VerticalAlignment="Top" Margin="0,0,14,0">
                        <Image Source="/Plain Craft Launcher 2;component/Images/Club/NJITMC.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="南京工程学院 Minecraft 社团" FontSize="13.5" Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock Text="用方块构建世界，用网络连接热爱。" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                        <UniformGrid Columns="3">
                            <local:MyButton x:Name="BtnClubHome" Text="社团官网" Height="32" Margin="0,0,5,0" />
                            <local:MyButton x:Name="BtnClubSite" Text="社团内网站点" Height="32" Margin="2,0" />
                            <local:MyButton x:Name="BtnClubMua" Text="MUA 皮肤站" Height="32" Margin="5,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="校内组网" x:Name="PanWg">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LabWgStatus" Grid.Row="0" Text="正在检查连接状态……" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource ColorBrush1}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="隧道名称" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgTunnel" Grid.Column="1" Text="—" FontSize="12" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="组网 IP" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgIp" Grid.Column="3" Text="—" FontSize="12" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="服务器" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgServer" Grid.Row="1" Grid.Column="1" Text="—" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="接收 / 发送" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgTraffic" Grid.Row="1" Grid.Column="3" Text="—" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="允许网段" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgSubnet" Grid.Row="2" Grid.Column="1" Text="—" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="保活间隔" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgKeepalive" Grid.Row="2" Grid.Column="3" Text="—" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="DNS" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgDns" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="—" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="4" Text="本机公钥" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgPublicKey" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="—" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="5" Text="配置文件" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabWgConf" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="—" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <local:MyButton x:Name="BtnWgConnect" Grid.Row="2" Height="38" Margin="0,10,0,0" Text="连接校内组网服务器" ColorType="Highlight" />
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}"
                               Text="需要连接校园网。登录正版或 MUA 账号后自动获取并导入配置；连接时会请求管理员权限。两个都已连接校内组网的客户端可以互相联机。" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                        <local:MyTextButton x:Name="BtnWgLoginMua" HorizontalAlignment="Left" Content="登录 MUA 账号" FontSize="12.5" Padding="0" HorizontalContentAlignment="Left" Margin="0,0,18,0" />
                        <local:MyTextButton x:Name="BtnWgGuide" HorizontalAlignment="Left" Content="还没有注册？查看教程" FontSize="12.5" Padding="0" HorizontalContentAlignment="Left" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="服务器" x:Name="PanPack">
                <StackPanel Margin="21,40,21,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabPackStatus" Text="正在获取服务器状态……" TextWrapping="Wrap" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyTextButton x:Name="BtnPackCheck" Content="检查更新" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" ToolTip="重新检测已安装的整合包是否有新修订" />
                            <local:MyTextButton x:Name="BtnPackRegister" Content="重置标记" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" ToolTip="清空本机整合包实例的修订标记，并按实际文件自动重新识别" />
                            <local:MyTextButton x:Name="BtnRefreshAll" Content="刷新" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" ToolTip="重新获取服务器列表、组网状态与账号信息" />
                            <local:MyTextButton x:Name="BtnPackCancel" Content="取消下载" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <local:MyTextButton x:Name="BtnToggleOnline" Margin="0,8,0,0" HorizontalAlignment="Left" Content="▾ 在营 0 台" FontSize="12.5" Padding="0" HorizontalContentAlignment="Left" Visibility="Collapsed" />
                    <StackPanel x:Name="PanPackOnline" Margin="0,6,0,0" />
                    <local:MyTextButton x:Name="BtnToggleArchived" Margin="0,4,0,0" HorizontalAlignment="Left" Content="▸ 已结档 0 台" FontSize="12" Opacity="0.72" Padding="0" HorizontalContentAlignment="Left" Visibility="Collapsed" />
                    <StackPanel x:Name="PanPackArchived" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="LabPackHint" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="优先连接校园网或校内组网下载，速度最快；状态来自社团站点的最新探测。下载整合包需要 MUA 账号登录，安装为独立版本，不影响现有游戏。" />
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanCustom">
            </StackPanel>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
