<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,0,0,15" Title="方块次元 · NJIT Minecraft Club" x:Name="PanClub">
                <Grid Margin="21,40,21,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True" VerticalAlignment="Top" Margin="0,0,14,0">
                        <Image Source="/Plain Craft Launcher 2;component/Images/Club/NJITMC.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="南京工程学院 Minecraft 社团" FontSize="13.5" Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock Text="用方块构建世界，用网络连接热爱。" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                        <UniformGrid Columns="2">
                            <local:MyButton x:Name="BtnClubHome" Text="社团官网" Height="32" Margin="0,0,4,0" />
                            <local:MyButton x:Name="BtnClubMua" Text="MUA 皮肤站" Height="32" Margin="4,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="联机模式" x:Name="PanSocialMode">
                <StackPanel Margin="21,38,21,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabSocialMode" Text="联机、好友与社团生活" FontSize="13.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSocialMode" Height="30" MinWidth="96"
                                        Text="已开启" Click="ToggleSocialMode" />
                    </Grid>
                    <TextBlock x:Name="LabSocialModeHint" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="关闭后联机入口会置灰，访客的进服设置也会清空。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="社团生活" x:Name="PanClubLife">
                <StackPanel Margin="21,40,21,16">
                    <Grid x:Name="PanDeviceAuth" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabDeviceAuth" Text="请先官网授权启动器，才可以使用社团功能"
                                   FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <local:MyButton Grid.Column="1" x:Name="BtnDeviceAuth" Text="授权启动器"
                                        Height="28" MinWidth="96" Margin="10,0,0,0" Click="StartDeviceAuth" />
                    </Grid>
                    <local:ClubLifePanel x:Name="PanClubLifeBody" />
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanCustom">
            </StackPanel>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
