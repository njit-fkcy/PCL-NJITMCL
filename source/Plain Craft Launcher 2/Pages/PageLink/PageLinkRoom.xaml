<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageLinkRoom"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="我的房间">
                <StackPanel Margin="25,40,19,20">
                    <TextBlock x:Name="LabStatus" Text="正在连接服务器……" TextWrapping="Wrap" Opacity="0.6"
                               FontSize="12" />
                    <StackPanel x:Name="PanRoomArea" Margin="0,12,0,0" />
                    <StackPanel x:Name="PanOtherRooms" Margin="0,14,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
