<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageLinkFriend"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="好友">
                <StackPanel Margin="25,40,19,20">
                    <StackPanel x:Name="PanTools" Orientation="Horizontal" />
                    <TextBlock x:Name="LabStatus" Text="正在连接服务器……" TextWrapping="Wrap" Opacity="0.6"
                               FontSize="12" Margin="0,10,0,0" />
                    <StackPanel x:Name="PanSearch" Margin="0,10,0,0" />
                    <StackPanel x:Name="PanIncoming" Margin="0,6,0,0" />
                    <StackPanel x:Name="PanFriends" Margin="0,6,0,0" />
                    <StackPanel x:Name="PanBlocked" Margin="0,10,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
