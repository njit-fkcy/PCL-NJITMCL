<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageLinkServer"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="整合包修订" x:Name="PanPackUpdate" Visibility="Collapsed">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock x:Name="LabPackUpdate" Text="" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ColorBrush1}" />
                    <Border x:Name="PanPackProgress" Margin="0,12,0,0" Padding="10,8,10,10" CornerRadius="4"
                            Background="{DynamicResource ColorBrush8}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="LabPackProgress" Text="" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ColorBrush1}" />
                            <ProgressBar x:Name="BarPackProgress" Height="6" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0"
                                         BorderThickness="0" Background="{DynamicResource ColorBrush7}" Foreground="{DynamicResource ColorBrush3}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="{TemplateBinding Foreground}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnPackUpdate" Height="34" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Padding="24,0" BorderThickness="0" Cursor="Hand" Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource ColorBrush2}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorBrush3}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorBrush1}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="立即更新" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                    </Button>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15" Title="服务器" x:Name="PanPack">
                <StackPanel Margin="21,40,21,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabPackStatus" Text="正在获取服务器状态……" TextWrapping="Wrap" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyTextButton x:Name="BtnPackCheck" Content="检查更新" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" ToolTip="重新检测已安装的整合包是否有新修订" />
                            <local:MyTextButton x:Name="BtnPackRegister" Content="重置标记" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" ToolTip="清空本机整合包实例的修订标记，并按实际文件自动重新识别" />
                            <local:MyTextButton x:Name="BtnRefreshAll" Content="刷新" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" ToolTip="重新获取服务器列表与账号信息" />
                            <local:MyTextButton x:Name="BtnPackCancel" Content="取消下载" FontSize="12" Margin="10,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Right" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <local:MyTextButton x:Name="BtnToggleOnline" Margin="0,8,0,0" HorizontalAlignment="Left" Content="▾ 在营 0 台" FontSize="12.5" Padding="0" HorizontalContentAlignment="Left" Visibility="Collapsed" />
                    <StackPanel x:Name="PanPackOnline" Margin="0,6,0,0" />
                    <local:MyTextButton x:Name="BtnToggleArchived" Margin="0,4,0,0" HorizontalAlignment="Left" Content="▸ 已结档 0 台" FontSize="12" Opacity="0.72" Padding="0" HorizontalContentAlignment="Left" Visibility="Collapsed" />
                    <StackPanel x:Name="PanPackArchived" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="LabPackHint" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="优先连接校园网或校园内网源下载，速度最快；状态来自社团站点的最新探测。下载整合包需要 MUA 账号登录，安装为独立版本，不影响现有游戏。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
