<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageLinkMessage"
    PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMain" Margin="25,10">
                <local:MyCard Margin="0,15" Title="消息">
                    <StackPanel Margin="25,40,19,20">
                        <StackPanel x:Name="PanTools" Orientation="Horizontal" />
                        <TextBlock x:Name="LabStatus" Text="正在连接服务器……" TextWrapping="Wrap" Opacity="0.6"
                                   FontSize="12" Margin="0,10,0,0" />
                        <StackPanel x:Name="PanSystem" Margin="0,10,0,0" />
                        <StackPanel x:Name="PanConversations" Margin="0,6,0,0" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>

        <!-- 聊天卡片：点好友后覆盖整个页面 -->
        <Border x:Name="PanChat" Visibility="Collapsed" Background="{DynamicResource ColorBrush8}">
            <Grid Margin="25,14,25,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:MyButton x:Name="BtnChatBack" Text="← 返回" Height="30" MinWidth="80"
                                    VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ContentControl x:Name="PanChatAvatar" VerticalAlignment="Center" />
                        <TextBlock x:Name="LabChatName" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource ColorBrush7}"
                        Background="{DynamicResource ColorBrush8}">
                    <local:MyScrollViewer x:Name="PanChatScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanChatList" Margin="14,12" />
                    </local:MyScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:MyTextBox x:Name="TxtMessage" Height="34" MaxLength="500" HintText="输入消息，回车发送"
                                     VerticalContentAlignment="Center" />
                    <local:MyButton Grid.Column="1" x:Name="BtnSend" Text="发送" Height="34" MinWidth="80"
                                    Margin="8,0,0,0" ColorType="Highlight" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</local:MyPageRight>
