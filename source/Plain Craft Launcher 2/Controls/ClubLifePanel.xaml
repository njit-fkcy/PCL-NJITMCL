<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="ClubLifePanel">
    <Grid>
        <StackPanel x:Name="PanRoot">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabState" Text="正在读取社团生活……" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray3}" />
                <local:MyTextButton x:Name="BtnReload" Grid.Column="1" Content="刷新" FontSize="12"
                                    Margin="10,0,0,0" Padding="0" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Right" ToolTip="重新读取活动、投票与个人记录" />
            </Grid>
            <UniformGrid Columns="3" Margin="0,12,0,0">
                <local:MyButton x:Name="BtnTabMe" Text="个人中心" Height="32" Margin="0,0,5,0"
                                ColorType="Highlight" />
                <local:MyButton x:Name="BtnTabEvents" Text="活动报名" Height="32" Margin="2,0" />
                <local:MyButton x:Name="BtnTabPolls" Text="社团投票" Height="32" Margin="5,0,0,0" />
            </UniformGrid>
            <StackPanel x:Name="PanBody" Margin="0,14,0,0" />
        </StackPanel>
        <Border x:Name="PanCheckin" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="10">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360"
                    Background="{DynamicResource ColorBrush8}" CornerRadius="8" Padding="22"
                    BorderThickness="1" BorderBrush="{DynamicResource ColorBrush7}">
                <StackPanel>
                    <TextBlock x:Name="LabCheckinTitle" Text="活动签到" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" />
                    <TextBlock Text="请输入现场公开的 6 位签到码，签到结果会记录到你的活动报名里。"
                               FontSize="11.5" Foreground="{DynamicResource ColorBrushGray3}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <local:MyTextBox x:Name="TxtCheckinCode" MaxLength="6" FontSize="18" Height="38"
                                     Margin="0,14,0,0" VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center" HintText="6 位数字" />
                    <TextBlock x:Name="LabCheckinHint" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <local:MyButton x:Name="BtnCheckinCancel" Text="取消" Height="30" MinWidth="88"
                                        Margin="0,0,8,0" />
                        <local:MyButton x:Name="BtnCheckinOk" Text="确认签到" Height="30" MinWidth="104"
                                        ColorType="Highlight" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
